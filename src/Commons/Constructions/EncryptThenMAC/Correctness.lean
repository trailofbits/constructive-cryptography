module

public import Commons.Constructions.EncryptThenMAC
public import Commons.Definitions.AEAD.Keyed
public import Commons.Definitions.MAC.Keyed
public import RandomSystems.Typed.SamplingAlgebra

/-!
# Correctness of encrypt-then-MAC

`encryptThenMAC.system.eq_keyed` expresses the named assembly with independently retained keys
and the reply law `encryptThenMAC.system.replyLaw`. Its encryption reply is the joint law of a
ciphertext and its tag; decryption verifies before using the retained encryption key.
`encryptThenMAC.body_memorylessReplyLaw` computes the two-call law at fixed keys, and
`encryptThenMAC.smul_ofMemoryless` lifts it through attachment. Scoping the independent
retained draws gives `encryptThenMAC.system.eq_keyed`.

The component contracts require that “each of these possible ciphertexts should decrypt to m”
[1, §2.2.1, p. 14] and that “tags generated by S are always accepted by V”
[1, Definition 6.1, p. 217].
`encryptThenMAC.system.replyLaw_dec_eq_of_correct` applies both contracts to a supported
encrypted/tagged pair. `TypedSystem.keyed_snoc_snoc_eq_of_support` transfers this implication to
`encryptThenMAC.system.enc_dec_eq_of_correct`: appending decryption of an encryption reply
preserves its prefix probability and recovers the original message, after any prior transcript.

## References

1. D. Boneh and V. Shoup. *A Graduate Course in Applied Cryptography*. Version 0.6, 2023.
-/

@[expose] public section

namespace Commons

open SystemAlgebra SystemAlgebra.DSL Probability Probability.Distribution
open scoped SystemAlgebra

noncomputable section

-- `K`, `L` carry independent encryption/MAC keys; `M`, `C`, `T` carry messages, ciphertexts,
-- and tags. The finite interfaces use `M`, `C`, `T`; `SymmetricEncryption.encryptions` and
-- `MAC.tags` index finite keys, with decidable equality on `K × M` and `L × C`.
variable {K L M C T : Type} [Fintype K] [Fintype L]
  [Fintype M] [Fintype C] [Fintype T]
  [DecidableEq K] [DecidableEq L] [DecidableEq M] [DecidableEq C]

/-- For retained `keys = (ke, km)`, draw `c ∼ scheme.enc ke m` then `t ∼ mac.tag km c`
and reply `(c, t)`: [1, §9.4.1, p. 367], “Output (c, t)”.
Decryption replies `scheme.dec ke c` if verification accepts, and `none` otherwise. -/
def encryptThenMAC.system.replyLaw
    -- `scheme`, `mac` supply the operations; `keys` is the retained pair shared across queries.
    (scheme : SymmetricEncryption K M C) (mac : MAC L C T) (keys : K × L) :
    -- Budget `0` names the port alphabets, shared by every outside query budget.
    ∀ i, (AE M (C × T) 0).X i → ProbDist ((AE M (C × T) 0).Y i)
  | .enc, m => ProbDist.jointLaw (scheme.enc keys.1 m) (mac.tag keys.2)
  | .dec, ct => ProbDist.single
      (if mac.verify keys.2 ct.1 ct.2 then scheme.dec keys.1 ct.1 else none)

omit [Fintype K] [Fintype L] [DecidableEq K] [DecidableEq L]
    [DecidableEq M] [DecidableEq C] in
/-- The two-call reply law is joint encryption/tagging and verified decryption. -/
lemma encryptThenMAC.body_memorylessReplyLaw
    -- `scheme`, `mac` supply fixed-key reply laws at `keys` for their respective ports.
    (scheme : SymmetricEncryption K M C) (mac : MAC L C T) (keys : K × L)
    -- `s` is arbitrary and `i(x)` the outside query; allow two calls from empty history `[]`.
    (s : Option Unit) (i : AE.Port) (x : (AE M (C × T) 0).X i) :
    (encryptThenMAC.body M C T).memorylessReplyLaw
      (RandomSystem.parallelLaw (AE.system.replyLaw scheme keys.1)
        (MAC.system.replyLaw mac keys.2)) s i x 2 [] =
      (encryptThenMAC.system.replyLaw scheme mac keys i x).1 := by
  cases i with
  | enc =>
    -- Encryption queries the cipher, then authenticates exactly its returned ciphertext.
    simp only [Program.memorylessReplyLaw, (encryptThenMAC.enc_query_eq (C := C) (T := T)),
      (encryptThenMAC.enc_tag_query_eq (T := T)),
      (encryptThenMAC.enc_eq (M := M) (C := C) (T := T)),
      List.nil_append, List.cons_append, RandomSystem.parallelLaw,
      AE.system.replyLaw, MAC.system.replyLaw, encryptThenMAC.system.replyLaw,
      ProbDist.jointLaw, ProbDist.bind_val, ProbDist.map_val, bindK_single_comp]
  | dec =>
    rcases x with ⟨c, t⟩
    -- Verification is deterministic at the retained MAC key, so exactly one branch remains.
    cases hv : mac.verify keys.2 c t <;>
      simp only [Program.memorylessReplyLaw, (encryptThenMAC.dec_query_eq (M := M)),
        (encryptThenMAC.dec_cipher_query_eq (M := M)), (encryptThenMAC.dec_eq_false (M := M)),
        (encryptThenMAC.dec_eq_true (M := M) (C := C) (T := T)), List.nil_append, List.cons_append,
        RandomSystem.parallelLaw, AE.system.replyLaw, MAC.system.replyLaw,
        encryptThenMAC.system.replyLaw, ProbDist.single, bindK_single, one_smul,
        hv, Bool.false_eq_true, ↓reduceIte]

omit [Fintype K] [Fintype L] [DecidableEq K] [DecidableEq L]
    [DecidableEq M] [DecidableEq C] in
/-- At fixed keys, attachment to the two component memoryless systems gives `ofMemoryless ν`,
with inside allowances `2 * q` and outside allowance `q`. -/
lemma encryptThenMAC.smul_ofMemoryless
    -- `scheme`, `mac` give the fixed-key component laws; `keys` fixes both keys.
    (scheme : SymmetricEncryption K M C) (mac : MAC L C T) (keys : K × L)
    -- `q` is the outside allowance; the generated inside allowance is `2 * q` per component.
    (q : ℕ) :
    encryptThenMAC M C T •
        (TypedSystem.ofMemoryless (AE M C (2 * q)) (AE.system.replyLaw scheme keys.1) ∥
          TypedSystem.ofMemoryless (Tagging C T (2 * q)) (MAC.system.replyLaw mac keys.2)) =
      TypedSystem.ofMemoryless (AE M (C × T) q)
        (encryptThenMAC.system.replyLaw scheme mac keys) := by
  -- Independent component replies have the parallel port law; the converter uses two calls.
  rw [Interface.cc_parallel_eq, TypedSystem.parallel_ofMemoryless,
    encryptThenMAC, encryptThenMAC.program]
  apply TypedConverter.ofProgram_smul_ofMemoryless _ _ _ _ rfl
  intro s i x
  exact encryptThenMAC.body_memorylessReplyLaw scheme mac keys s i x

/-- `system = keyed (genₑ × genₘ) ν`: retain one key pair with independent coordinates,
then draw each query's reply from its law at that pair. -/
lemma encryptThenMAC.system.eq_keyed
    -- `scheme`, `mac` supply the retained component laws; `q` is the outside query budget.
    (scheme : SymmetricEncryption K M C) (mac : MAC L C T) (q : ℕ) :
    encryptThenMAC.system scheme mac q =
      TypedSystem.keyed (A := AE M (C × T) q) (prodProbDist scheme.gen mac.gen)
        (encryptThenMAC.system.replyLaw scheme mac) := by
  -- Rewrite each complete component once, retaining its own key and fresh per-call replies.
  rw [encryptThenMAC.system_eq, AE.system.eq_keyed, MAC.system.eq_keyed]
  simp only [TypedSystem.keyed, Interface.cc_parallel_eq, Interface.smul_eq_typed_smul]
  -- Scope the encryption draw first, then the independent MAC draw, preserving port order.
  rw [TypedSystem.parallel_sample_left]
  simp only [TypedSystem.parallel_sample_right, TypedConverter.smul_sample]
  -- The nested draws are exactly the product law; fixed-key attachment supplies each summand.
  change _ = TypedSystem.sample (scheme.gen.1.prod mac.gen.1)
    (fun keys => TypedSystem.ofMemoryless (AE M (C × T) q)
      (encryptThenMAC.system.replyLaw scheme mac keys))
  rw [TypedSystem.sample_prod]
  congr 1
  funext k
  congr 1
  funext l
  exact encryptThenMAC.smul_ofMemoryless scheme mac (k, l) q

omit [Fintype K] [Fintype L] [DecidableEq K] [DecidableEq L]
    [DecidableEq M] [DecidableEq C] in
/-- Every supported ciphertext/tag pair verifies and decrypts to the original message. -/
lemma encryptThenMAC.system.replyLaw_dec_eq_of_correct
    -- `scheme`, `mac` supply the components; `henc`, `hmac` are their correctness contracts.
    (scheme : SymmetricEncryption K M C) (mac : MAC L C T)
    (henc : scheme.Correct) (hmac : mac.Correct)
    -- `hk`, `hl` support the independently retained encryption and MAC keys.
    (keys : K × L) (hk : keys.1 ∈ scheme.gen.1.support) (hl : keys.2 ∈ mac.gen.1.support)
    -- `hct` supports the complete encryption reply `(ciphertext, tag)` to `m`.
    (m : M) (ct : C × T)
    (hct : ct ∈ (encryptThenMAC.system.replyLaw scheme mac keys .enc m).1.support) :
    encryptThenMAC.system.replyLaw scheme mac keys .dec ct = ProbDist.single (some m) := by
  -- Joint-law support supplies a supported ciphertext and a supported tag on that ciphertext.
  obtain ⟨c, hc, htag⟩ := mem_support_bindK hct
  obtain ⟨t, ht, hpair⟩ := mem_support_fTransform _ _ htag
  subst ct
  -- Tag correctness selects decryption; encryption correctness gives its message reply.
  simp only [encryptThenMAC.system.replyLaw, hmac _ hl _ _ ht, ↓reduceIte, henc _ hk _ _ hc]

/-- `P[h, enc(m) → ct, dec(ct) → some m] = P[h, enc(m) → ct]` for the assembled system.
On every prefix of nonzero probability, decryption therefore recovers `m` with probability one. -/
theorem encryptThenMAC.system.enc_dec_eq_of_correct
    -- `scheme`, `mac` supply the components; `henc`, `hmac` give their correctness contracts.
    (scheme : SymmetricEncryption K M C) (mac : MAC L C T)
    (henc : scheme.Correct) (hmac : mac.Correct)
    -- `h` is any preceding transcript; `q` allows its two-query roundtrip extension by `hq`.
    (q : ℕ) (h : List ((Σ i, (AE M (C × T) q).X i) × (Σ i, (AE M (C × T) q).Y i)))
    (hq : h.length + 2 ≤ q)
    -- `m` is encrypted; `ct` is its complete ciphertext/tag reply, reused at decryption.
    (m : M) (ct : C × T) :
    (encryptThenMAC.system scheme mac q).1
        ((h ++ [(⟨.enc, m⟩, ⟨.enc, ct⟩)]) ++ [(⟨.dec, ct⟩, ⟨.dec, some m⟩)]) =
      (encryptThenMAC.system scheme mac q).1 (h ++ [(⟨.enc, m⟩, ⟨.enc, ct⟩)]) := by
  -- Both extensions lie in the assembly's total-query domain.
  have hdEnc : (AE M (C × T) q).inputDomain h ⟨.enc, m⟩ := by
    refine ⟨List.append_ne_nil_of_right_ne_nil _ (List.cons_ne_nil _ _), ?_⟩
    simp only [List.length_append, List.length_map, List.length_singleton]
    omega
  have hdDec : (AE M (C × T) q).inputDomain
      (h ++ [(⟨.enc, m⟩, ⟨.enc, ct⟩)]) ⟨.dec, ct⟩ := by
    refine ⟨List.append_ne_nil_of_right_ne_nil _ (List.cons_ne_nil _ _), ?_⟩
    simp only [List.length_append, List.length_map, List.length_singleton]
    omega
  -- A supported encrypted/tagged pair decrypts to `some m`, preserving the prefix mass.
  rw [encryptThenMAC.system.eq_keyed]
  apply TypedSystem.keyed_snoc_snoc_eq_of_support (hd := hdEnc) (hd' := hdDec)
  intro keys hkeys hct
  obtain ⟨hk, hl⟩ := Finset.mem_product.mp (support_prod_subset scheme.gen.1 mac.gen.1 hkeys)
  rw [encryptThenMAC.system.replyLaw_dec_eq_of_correct scheme mac henc hmac keys hk hl m ct hct]
  exact Finsupp.single_eq_same

end

end Commons
